<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vehicle SDK (조회 전용, Vehicle Service protectionLevel="normal"): 실제 사용하는 최소 퍼미션만 선언 -->
    <!-- Odometer·Gear: CAR_DRIVE (Pleos Connect 에뮬레이터 2.1.0 에서 수신 확인). 공식 샘플 매니페스트는 CAR_MILEAGE 를 함께 선언 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <!-- Door: 운전석 도어 위치 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />

    <!-- NaviHelper SDK: 목적지 조회와 경로 이벤트 수신 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:name=".ChagokApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chagok">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 '기록 중' 상태 화면을 유지 (입력은 앱에서 차단) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
